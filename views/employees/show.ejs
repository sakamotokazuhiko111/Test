<div class="d-flex align-items-center mb-4">
  <a href="/employees" class="btn btn-outline-secondary btn-sm me-3">
    <i class="bi bi-arrow-left"></i>
  </a>
  <h1 class="h3 mb-0">社員詳細</h1>
  <div class="ms-auto d-flex gap-2">
    <a href="/employees/<%= employee.id %>/edit" class="btn btn-primary btn-sm">
      <i class="bi bi-pencil me-1"></i>編集
    </a>
    <form method="POST" action="/employees/<%= employee.id %>?_method=DELETE"
          data-confirm="「<%= employee.name %>」を削除しますか？">
      <button type="submit" class="btn btn-outline-danger btn-sm">
        <i class="bi bi-trash me-1"></i>削除
      </button>
    </form>
  </div>
</div>

<div class="row">
  <div class="col-md-8">
    <div class="card shadow-sm">
      <div class="card-header d-flex align-items-center">
        <div class="me-3">
          <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center text-white fw-bold"
               style="width:56px;height:56px;font-size:1.4rem;">
            <%= employee.name.charAt(0) %>
          </div>
        </div>
        <div>
          <h4 class="mb-0"><%= employee.name %></h4>
          <% if (employee.name_kana) { %><small class="text-muted"><%= employee.name_kana %></small><% } %>
        </div>
        <div class="ms-auto">
          <% if (employee.status === 'active') { %>
          <span class="badge bg-success fs-6">在職</span>
          <% } else { %>
          <span class="badge bg-secondary fs-6">退職</span>
          <% } %>
        </div>
      </div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-sm-3 text-muted">部署</dt>
          <dd class="col-sm-9"><%= employee.department_name || '-' %></dd>
          <dt class="col-sm-3 text-muted">役職</dt>
          <dd class="col-sm-9"><%= employee.position || '-' %></dd>
          <dt class="col-sm-3 text-muted">メール</dt>
          <dd class="col-sm-9">
            <% if (employee.email) { %>
            <a href="mailto:<%= employee.email %>"><%= employee.email %></a>
            <% } else { %>-<% } %>
          </dd>
          <dt class="col-sm-3 text-muted">電話</dt>
          <dd class="col-sm-9"><%= employee.phone || '-' %></dd>
          <dt class="col-sm-3 text-muted">入社日</dt>
          <dd class="col-sm-9"><%= employee.hire_date || '-' %></dd>
          <% if (employee.notes) { %>
          <dt class="col-sm-3 text-muted">備考</dt>
          <dd class="col-sm-9"><%= employee.notes %></dd>
          <% } %>
        </dl>
      </div>
      <div class="card-footer text-muted small">
        登録: <%= employee.created_at %> &nbsp;/&nbsp; 更新: <%= employee.updated_at %>
      </div>
    </div>
  </div>
</div>
