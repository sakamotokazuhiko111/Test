<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0"><i class="bi bi-diagram-3-fill me-2 text-primary"></i>部署管理</h1>
  <a href="/departments/new" class="btn btn-primary">
    <i class="bi bi-plus-circle me-1"></i>新規登録
  </a>
</div>

<div class="card shadow-sm">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>ID</th>
          <th>部署名</th>
          <th>社員数</th>
          <th>登録日</th>
          <th class="text-end">操作</th>
        </tr>
      </thead>
      <tbody>
        <% if (departments.length === 0) { %>
        <tr>
          <td colspan="5" class="text-center py-4 text-muted">部署が登録されていません</td>
        </tr>
        <% } %>
        <% departments.forEach(dept => { %>
        <tr>
          <td class="text-muted">#<%= dept.id %></td>
          <td class="fw-semibold"><%= dept.name %></td>
          <td>
            <span class="badge bg-secondary"><%= dept.employeeCount %>名</span>
          </td>
          <td class="text-muted small"><%= dept.created_at.slice(0, 10) %></td>
          <td class="text-end">
            <a href="/departments/<%= dept.id %>/edit" class="btn btn-sm btn-outline-primary me-1">
              <i class="bi bi-pencil"></i>
            </a>
            <form method="POST" action="/departments/<%= dept.id %>?_method=DELETE" class="d-inline"
                  data-confirm="「<%= dept.name %>」を削除しますか？">
              <button type="submit" class="btn btn-sm btn-outline-danger">
                <i class="bi bi-trash"></i>
              </button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
