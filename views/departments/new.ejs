<div class="d-flex align-items-center mb-4">
  <a href="/departments" class="btn btn-outline-secondary btn-sm me-3">
    <i class="bi bi-arrow-left"></i>
  </a>
  <h1 class="h3 mb-0">部署登録</h1>
</div>

<div class="card shadow-sm" style="max-width: 500px;">
  <div class="card-body">
    <% if (errors.length > 0) { %>
    <div class="alert alert-danger">
      <% errors.forEach(e => { %><div><%= e %></div><% }) %>
    </div>
    <% } %>
    <form method="POST" action="/departments">
      <div class="mb-3">
        <label class="form-label fw-semibold">部署名 <span class="text-danger">*</span></label>
        <input type="text" name="name" class="form-control" value="<%= data.name || '' %>" required>
      </div>
      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
          <i class="bi bi-check-circle me-1"></i>登録
        </button>
        <a href="/departments" class="btn btn-outline-secondary">キャンセル</a>
      </div>
    </form>
  </div>
</div>
